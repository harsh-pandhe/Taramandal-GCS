# Python virtual environments and caches
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/

# Node packages and build outputs
node_modules/
dist/
dist-ssr/
*.local
.vite/

# PX4 SITL runtime files and logs
dataman
parameters.bson
parameters_backup.bson
log/
etc/
*.ulg
/tmp/px4_*.log
/tmp/gz_*.log

# Generated show exports (Studio writes CSV/JSON/KML here).
# NOTE: scoped to this directory on purpose. The old taramandal-studio repo
# used a bare `*.json`, which silently untracked frontend/package.json and
# package-lock.json — a fresh clone could not npm install. Do not reintroduce it.
/exports/

# System files
.DS_Store
Thumps.db

# Claude Code session/worktree dirs
.claude/

packages/tara-gcs/tara_gcs/exports/

# Measurement output from tools/ — regenerated by re-running the scripts, and
# machine-specific (numbers reflect whatever host produced them), so the
# committed write-ups in docs/ are the durable record, not these. Scoped to the
# two known filenames rather than tools/*.json, which would also swallow any
# checked-in fixture a future tool needs.
/tools/benchmark_results.json
/tools/calibration_results.json

# Per-process stdout/stderr from simulations the GCS launched (see
# tara_gcs.sim_manager.LOG_DIR_NAME). Runtime output of one launch on one
# machine — the dashboard reads these back for diagnosing a failed launch, but
# nothing about them belongs in version control.
/sim_logs/

# Proprietary In-House Hardware, CAD, BOM, and Strategic Plans (Local Only)
plan/
hardware/

