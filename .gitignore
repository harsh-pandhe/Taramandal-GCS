.DS_Store
Thumps.db

# Claude Code session/worktree dirs
.claude/

packages/tara-gcs/tara_gcs/exports/

# Persisted active-show state (issue #4) — runtime data, not source.
packages/tara-gcs/tara_gcs/show_state.json
